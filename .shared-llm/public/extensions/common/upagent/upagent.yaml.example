# UpAgent Recruiter launch templates — PUBLIC TEMPLATE.
#
# Copy to `upagent.yaml` (next to recruiter.py) in the destination and adapt. In a split
# destination the FILLED roster is repo-owned: it lives under `.shared-llm/this_repo/` and
# is never overwritten by `just update` (this .example ships from the kit as the starting
# point).
#
# The roster is keyed by HARNESS, not by worker type or persona. route.yaml is authoritative
# for which harness/model/agent runs each stage; the Recruiter only knows HOW to launch each
# harness as a Herdr pane. It never decides the agent.
#
# Each template is a Python str.format() string. Available placeholders:
#   {model}             resolved model id from the route llm_profile (the route schema requires
#                       a model per profile, so this is never empty on a route-driven order —
#                       which matters, because a flag like `--model {model}` handed an empty
#                       value would make the CLI eat the next token as the model)
#   {agent}             the persona/agent name from the route stage entry
#   {effort}            reasoning effort from the route llm_profile — the leader resolves it
#                       to `medium` when the profile omits it, so it is never empty
#   {cwd}               the phase worktree (also set as the pane's --cwd)
#   {instructions_path} absolute path to the stage brief the worker must read
#   {result_path}       absolute path the worker MUST write result.json to
#   {order_id}          exact order identity the worker MUST echo in result.json
#
# Model-id shapes differ per harness: claude takes an alias or full name (`opus`,
# `claude-opus-4-8`) plus `--effort low|medium|high|xhigh|max`; Codex takes a bare model id
# (`gpt-5.6-sol`) plus `-c model_reasoning_effort={effort}`; pi takes `provider/id` with an
# optional `:<thinking>` suffix (`openai-codex/gpt-5.6-sol:high`), so for pi the effort rides
# INSIDE {model} and {effort} is not used.
#
# IMPORTANT: because templates are str.format() strings, any LITERAL brace must be DOUBLED —
# write `${{VAR}}` for a shell variable and `{{a,b}}` for a literal brace group. A single
# unescaped `{...}` that is not one of the placeholders above is a template authoring error.
#
# Every worker's job is the same shape: read the instructions, do the one stage, and write a
# valid result.json (verdict + revisit + full_log pointer) before finishing. The Recruiter
# races one event subscription against the lease-private result; `done` is an accelerator,
# never the verdict or the durable completion record.
#
# NON-INTERACTIVE IS MANDATORY. A worker runs unattended in a pane, so every launch template
# MUST bypass all trust/permission prompts or the worker hangs forever at a dialog (and the
# Recruiter's wait times out). The bypass per harness:
#   claude → --dangerously-skip-permissions             (trusts cwd, incl. a fresh worktree)
#   codex  → --dangerously-bypass-approvals-and-sandbox (with --skip-git-repo-check)
#   pi     → --approve                                  (trusts project-local files for the run)
#   cursor → --print --force                            (non-interactive + approve commands)
#
# PI WORKERS RUN INSULATED. `--no-extensions` turns off extension discovery so a broken
# globally-installed extension can never brick orchestrated workers (a half-installed
# extension once rerouted every bash/read call through a missing binary — every worker
# died on its first tool call). Explicit `-e` paths still load, and one is REQUIRED:
# Herdr's pi integration (`herdr integration install pi` puts it at
# $HOME/.pi/agent/extensions/herdr-agent-state.ts) is what reports the pane's
# agent-status — without it the Recruiter's `herdr wait agent-status --status done`
# never fires and every pi hire times out to blocked. Interactive pi sessions are
# untouched — they keep the full extension set. Note pi has NO --agent flag: the
# persona comes to the worker through the stage brief, not the CLI.

# LLM lifecycle roles are separate from work routes. They interpret configuration and bounded
# health evidence; Python remains the only pane/process executor. Role commands may use
# {brief_path}, {cwd}, and {output_path}.
#
# mode: direct (default) — NO standing Dedicated Account Manager LLM per request. Python
# fail-loud validates before launch, owns lease/monitor/timeout mechanics, and publishes
# durable requester events consumed by upagent-await / upagent-await-any. The
# account_manager block below is used only if mode is flipped to `dedicated`.
management:
  mode: direct
  startup_timeout_ms: 45000
  inactivity_check_ms: 900000
  requester_grace_ms: 300000
  account_manager:
    command: >-
      claude --dangerously-skip-permissions --agent upagent-account-manager
      --model sonnet --effort low
      "Read {brief_path}, perform that one lifecycle review, write {output_path},
      then remain available."
    expected_agent: claude
    expected_process: claude
    timeout_ms: 120000
  checker:
    command: >-
      claude --dangerously-skip-permissions --agent upagent-checker
      --model haiku --effort low
      "Read {brief_path}, perform that one bounded assessment, write {output_path}, then exit."
    expected_agent: claude
    expected_process: claude
    timeout_ms: 120000

# Optional process-detector overrides. Use these when a harness wrapper changes what Herdr reports.
# A mismatch fails startup; the Hub never guesses that some unrelated foreground process is healthy.
health:
  claude:
    expected_agent: claude
    expected_process: claude
  codex:
    expected_agent: codex
    expected_process: codex
  pi:
    expected_agent: pi
    expected_process: pi
  cursor:
    expected_agent: cursor
    expected_process: cursor-agent

# Phase leaders are controllers, not stage workers. The deterministic phase-start transaction
# holds this command behind a filesystem gate, starts and verifies the phase watchdog through the
# ordinary UpAgent lifecycle, then releases the leader. Keeping separate templates prevents the
# controller from trying to trim a worker prompt or guess each harness's controller mode.
phase_leaders:
  claude: >-
    claude --dangerously-skip-permissions --agent {agent} --model {model} --effort {effort}
    "Read {instructions_path} and follow that phase-leader assignment."

  codex: >-
    codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check
    --model {model} -c model_reasoning_effort={effort}
    "Read {instructions_path} and follow that phase-leader assignment."

  pi: >-
    pi --approve --no-extensions -e "$HOME/.pi/agent/extensions/herdr-agent-state.ts"
    --model {model}
    "Read {instructions_path} and follow that phase-leader assignment."

  cursor: >-
    cursor-agent --print --force --model {model}
    "Read {instructions_path} and follow that phase-leader assignment."

harnesses:
  claude: >-
    claude --dangerously-skip-permissions --agent {agent} --model {model} --effort {effort}
    "Read {instructions_path} and do exactly that one stage in {cwd}.
    When finished, write exactly one result.json to {result_path} with order_id exactly {order_id}
    (verdict: passed|failed|blocked,
    a revisit list of stage-ids on failure, and a full_log pointer to your session transcript)."

  # Codex has no --agent flag. The persona comes from instructions_path. Codex also does not
  # reliably report agent-status=done; the Recruiter's generic token-scoped completion monitor
  # finalizes its private staged result without any Codex-specific public-result polling.
  codex: >-
    codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check
    --model {model} -c model_reasoning_effort={effort}
    "Read {instructions_path} and do exactly that one stage in {cwd}.
    Write exactly one result.json to {result_path} with order_id exactly {order_id}
    (verdict + revisit + full_log)."

  pi: >-
    pi --approve --no-extensions -e "$HOME/.pi/agent/extensions/herdr-agent-state.ts"
    --model {model}
    "Read {instructions_path}; do the stage in {cwd}; write exactly one result.json to
    {result_path} with order_id exactly {order_id} (verdict + revisit + full_log)."

  cursor: >-
    cursor-agent --print --force --model {model}
    "Read {instructions_path}; do the stage in {cwd}; write exactly one result.json to
    {result_path} with order_id exactly {order_id}."
