# Destination-owned specialist OVERLAY template.
# Copy to .shared-llm/this_repo/extensions/common/upagent/specialists.yaml.
# Entries merge by name over the kit base. Every entry must pin one id from offerings.yaml and
# an effort allowed by that offering; raw harness/model/command fields are rejected.

specialists:
  - name: backend
    location: .claude/agents/backend.md
    description: "Backend services, APIs, request contracts, tests, and failure diagnosis."
    offering: claude-sonnet-5
    effort: medium
    agent: backend
  - name: reviewer
    location: .claude/agents/reviewer.md
    description: "Independent read-only review with concrete file and evidence citations."
    offering: claude-opus-5
    effort: high
    agent: reviewer
