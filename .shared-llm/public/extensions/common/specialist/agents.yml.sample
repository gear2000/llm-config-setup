# agents.yml.sample — base Specialist Hub roster
#
# Copy this file to the destination-owned:
#   .shared-llm/this_repo/extensions/common/specialist/agents.yaml
#
# The entries below are generic public roles. Change harness/model values to match the
# destination's installed runtimes; do not put project-specific names, URLs, or credentials here.

runtime_dir: /tmp/.herdr-specialist

agents:
  - name: backend
    location: .claude/agents/backend.md
    description: "Backend services, APIs, request contracts, tests, and failure diagnosis."
    harness: claude
    model: configured-claude-model
    agent: backend
  - name: frontend
    location: .claude/agents/frontend.md
    description: "Frontend pages, components, routing, data fetching, and accessibility."
    harness: claude
    model: configured-claude-model
    agent: frontend
  - name: reviewer
    location: .claude/agents/reviewer.md
    description: "Independent read-only review with concrete file and evidence citations."
    harness: claude
    model: configured-claude-model
    agent: reviewer
    effort: high
  - name: qa
    location: .claude/agents/qa.md
    description: "Test execution, regression diagnosis, and acceptance evidence."
    harness: claude
    model: configured-claude-model
    agent: qa
  - name: terraform
    location: .claude/agents/terraform.md
    description: "Terraform implementation and plan analysis; apply remains human-gated."
    harness: claude
    model: configured-claude-model
    agent: terraform
  - name: aws
    location: .claude/agents/aws.md
    description: "AWS architecture, IAM, networking, and read-only operational diagnostics."
    harness: claude
    model: configured-claude-model
    agent: aws
  - name: github
    location: .claude/agents/github.md
    description: "GitHub repository, pull request, Actions, and collaboration workflows."
    harness: claude
    model: configured-claude-model
    agent: github
  - name: docs
    location: .claude/agents/docs.md
    description: "Documentation and repository structure questions."
    harness: claude
    model: configured-claude-model
    agent: docs
  - name: python
    location: .claude/agents/python.md
    description: "Python package layout, testing, typing, and runtime behavior."
    harness: pi
    model: configured-provider/configured-model
    agent: python
  - name: golang
    location: .claude/agents/golang.md
    description: "Go package layout, idioms, concurrency, and testing."
    harness: pi
    model: configured-provider/configured-model
    agent: golang
