# agents.yaml — roster for the Specialist Hub (`just specialist-hub`, hub.py in this dir)
#
# TEMPLATE. This file (agents.yaml.example) ships in the PUBLIC kit as a generic example.
# The engine (hub.py) is kit-synced; the FILLED roster is your destination's OWN config —
# save your copy as agents.yaml (in this repo's `this_repo` config) and edit it. Nothing
# proprietary lives in the kit; your real specialist names/definitions stay in your repo.
#
# The Librarian is one always-up pane in a `shared-services` Herdr workspace. It reads this
# roster to route a consult to the right specialist, which it spawns as a TRANSIENT pane,
# briefs with the question, and closes once the specialist writes its answer. No discovery
# magic: this file IS the roster. Each entry gives the specialist a name, points at its
# definition file, and states the FULL command that runs it — so specialists can mix
# harnesses (Pi, Claude Code, anything that runs in a Herdr pane).
#
#   just specialist-hub up          # create/attach shared-services + the Librarian pane
#   just specialist-hub status
#   just specialist-hub reindex     # rebuild index.json after editing this file
#   just specialist-hub down        # close the Librarian pane, drop runtime state
#
# Requires HERDR_ENV=1 (run inside Herdr) and the `herdr` CLI on PATH.

# Where runtime files land (state.json, index.json roster, consults/ drop-box).
runtime_dir: /tmp/.herdr-specialist

# Optional: the repository transient specialists run in so their file:line citations resolve.
# Defaults to the directory `up` was invoked from. Relative locations below are resolved from
# this repository root, never from the nested roster directory.
# repo_root: /path/to/your/repo

# IMPORTANT: every `cmd` MUST contain either `{prompt_file}` or `{prompt}` so the Librarian
# can inject the question + the answer.json contract:
#   {prompt_file} — substituted with a path to the briefing (shell-safe for any harness).
#   {prompt}      — substituted with the shell-quoted briefing text inline.
# The specialist must write STRICT JSON to the answer_path named in the consult, with keys
# `consult_id`, `answer`, and a non-empty `citations` list of `file:line` references.

agents:
  - name: docs
    location: .claude/agents/docs.md        # relative = resolved from repo_root
    description: "Answers documentation / markdown / site-structure questions."
    cmd: "claude -p {prompt} --agent docs"

  - name: python
    location: .claude/agents/python.md
    cmd: "pi --agent python --prompt-file {prompt_file}"

  # description is normally read from the definition file's frontmatter; set it here to override.
  - name: golang
    location: .claude/agents/golang.md
    description: "Answers Go idiom, package-layout, and concurrency questions."
    cmd: "pi --agent golang --prompt-file {prompt_file}"

  # Codex has no --agent flag. `{prompt_file}` is a shell-quoted PATH, not its contents, so pass
  # `-` as Codex's prompt argument and redirect stdin from the file. The Librarian polls this
  # consult's private answer_path because Codex may not report agent-status=done, then applies the
  # same strict answer validation and pane cleanup.
  - name: reviewer
    location: .claude/agents/reviewer.md
    description: "Provides an independent review with cited repository evidence."
    cmd: "codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check - < {prompt_file}"
