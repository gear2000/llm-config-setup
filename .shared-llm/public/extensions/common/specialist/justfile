# Specialist Hub module — the Librarian, an always-up Herdr pane that answers repo-knowledge
# questions by spawning a transient specialist per consult.
#
# This engine is PUBLIC (kit-synced) and lands in a destination at
#   .shared-llm/public/extensions/common/specialist/
# To adopt: import this justfile from your root justfile:
#   import '.shared-llm/public/extensions/common/specialist/justfile'
# then fill the roster — save agents.yml.sample as agents.yaml (in your `this_repo` config,
# next to hub.py) and edit it. Override the roster path with $SPECIALIST_HUB_CONFIG.
#
# Requires HERDR_ENV=1 (run inside Herdr) and the `herdr` CLI on PATH.

# Librarian: up | down | status | reindex | consult <consult.json>
specialist-hub *ARGS:
    ${PYTHON_BIN:-python3} {{justfile_directory()}}/.shared-llm/public/extensions/common/specialist/hub.py {{ARGS}}
