# Herdr runner entry module — justfile-driven bring-up and plan kickoff.
#
# Herdr runs agents NATIVELY in panes (visible TUIs, agent-status tracked in the
# sidebar); nothing here ever runs a harness headless. These recipes are the
# alternative entry point to starting Claude Code / Pi by hand and typing the
# slash command — `just` drives the Herdr socket directly.
#
# This module is PUBLIC (kit-synced) and lands in a destination at
#   .shared-llm/public/extensions/common/herdr/
# To adopt, import it (plus its sibling engine) from your root justfile:
#   import '.shared-llm/public/extensions/common/upagent/justfile'
#   import '.shared-llm/public/extensions/common/herdr/justfile'
#
# Requires the `herdr` CLI on PATH with a running Herdr. The engines are driven
# over the Herdr unix socket, so these work from any shell (HERDR_ENV is set
# explicitly where an engine insists on it).
#
# FUTURE: a `herdr-plan-from-issue <github-or-linear-ref>` recipe can fetch the
# plan/details from a GitHub or Linear issue into a run dir (plan.md +
# route.yaml) and then delegate to `herdr-plan` — the kickoff below stays the
# single entry seam, so issue-driven runs are an additive fetcher, not a fork.

_UPAGENT := justfile_directory() + "/.shared-llm/public/extensions/common/upagent/recruiter.py"
_PLAN_CONTROLLER := justfile_directory() + "/.shared-llm/public/extensions/common/herdr/plan_controller.py"
_HERDR_LAB := justfile_directory() + "/.shared-llm/public/extensions/common/herdr/lab_session.py"

# Bring up the always-up shared service (the UpAgent Recruiter, in its own role-labeled pane,
# registered in Herdr's agents sidebar), then print the status table so you can SEE it is up.
# By default everything shares ONE `herdr` workspace — the service lives in a `services` tab
# and each run adds control/workers/oversight tabs beside it. Pass `--separate-workspaces` to
# restore the dedicated `shared-services` workspace plus a per-run `<slug>` workspace (runs
# started later inherit whichever mode was chosen here).
herdr-up *FLAGS:
    ${PYTHON_BIN:-python3} {{_UPAGENT}} up {{FLAGS}}
    @{{just_executable()}} --justfile "{{justfile()}}" herdr-status

# Status of the shared service as a table with ✓ up (green) / ✗ down (red).
herdr-status:
    #!/usr/bin/env bash
    set -euo pipefail
    ${PYTHON_BIN:-python3} - <<'PY'
    import json, os, subprocess
    G, R, DIM, RST = "\033[32m", "\033[31m", "\033[2m", "\033[0m"
    def live_panes():
        try:
            out = subprocess.run(
                ["herdr", "pane", "list"], check=True, capture_output=True, text=True
            )
            return {p["pane_id"] for p in json.loads(out.stdout)["result"]["panes"]}
        except (FileNotFoundError, subprocess.CalledProcessError, json.JSONDecodeError, KeyError, TypeError):
            return set()
    panes = live_panes()
    def read(p):
        try:
            with open(p) as state:
                return json.load(state)
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return None
    rows = []
    # recruiter
    rec = read(os.environ.get("UPAGENT_STATE", "/tmp/.upagent/recruiter.json"))
    if rec and rec.get("recruiter_pane") in panes:
        rows.append(("recruiter", True, f"pane {rec['recruiter_pane']} · roster {os.path.basename(rec.get('roster',''))}"))
    else:
        rows.append(("recruiter", False, "not up — run `just herdr-up`"))
    W = max(len(d) for _,_,d in rows + [("","","Herdr shared services")])
    bar = "─" * (W + 2)
    print(f"┌──────────────┬────────┬{bar}┐")
    print(f"│ hub          │ state  │ {'detail'.ljust(W)} │")
    print(f"├──────────────┼────────┼{bar}┤")
    for name, up, detail in rows:
        mark = f"{G}✓ up  {RST}" if up else f"{R}✗ down{RST}"
        print(f"│ {name.ljust(12)} │ {mark} │ {DIM}{detail.ljust(W)}{RST} │")
    print(f"└──────────────┴────────┴{bar}┘")
    PY

# Tear down the shared services. The Recruiter engine first terminalizes every durably owned
# active worker and verifies pane cleanup; it never closes a foreign/unrecorded pane.
herdr-down:
    #!/usr/bin/env bash
    set -euo pipefail
    ${PYTHON_BIN:-python3} {{_UPAGENT}} down || true
    {{just_executable()}} --justfile "{{justfile()}}" herdr-status || true

# Kick off a checked plan through one deterministic Python transaction. It starts
# and health-checks a FRESH TUI — nothing else. There is no standing plan watchdog:
# the TUI hears every phase condition as the typed return of its blocking
# `upagent-phase-await`, and urgent unacknowledged events escalate to the human via
# `herdr notification`. Run `just herdr-up` first.
#
# The TUI is launched fully NON-INTERACTIVE (claude --dangerously-skip-permissions
# / pi --approve) — it trusts its cwd and never blocks on a trust/permission dialog
# — and the harness self-registers as a Herdr agent (name `tui-agent`), so it shows
# up in the agents sidebar and in Herdr's remote/phone agent list for you to watch
# and drive on the move. A Claude Code TUI ADDITIONALLY always starts with Claude's
# own Remote Control (`--remote-control=<slug>`), so the session appears in the
# claude.ai phone list under the run's name.
#
# The TUI joins the unified `herdr` workspace as a `control` tab by default; it
# inherits `--separate-workspaces` (per-run `<slug>` workspace) when `herdr-up`
# chose that mode, or when passed here explicitly.
#
#   just herdr-plan ops/work-log/2026-07-12/my-feature
#   just herdr-plan ops/work-log/2026-07-12/my-feature/plan/v1 my-feature
#   just herdr-plan ops/work-log/2026-07-12/my-feature "" pi
herdr-plan dir slug="" harness="claude" *FLAGS="":
    ${PYTHON_BIN:-python3} "{{_PLAN_CONTROLLER}}" "{{dir}}" --slug "{{slug}}" --harness "{{harness}}" --repo "{{invocation_directory()}}" {{FLAGS}}

# Publish the plan's durable terminal fact after run-status.md is complete. It is the run's
# only terminal authority (and lets any in-flight legacy watchdog retire safely).
herdr-plan-finish dir state slug="":
    ${PYTHON_BIN:-python3} "{{_PLAN_CONTROLLER}}" "{{dir}}" --slug "{{slug}}" --finish-state "{{state}}"

# Guarded non-default Herdr lab/session helper for smoke tests.
# Generate a name first, then provision/run/teardown through that exact name:
#   just herdr-lab name smoke
#   just herdr-lab provision <generated-session>
#   just herdr-lab run <generated-session> workspace list
#   just herdr-lab teardown <generated-session>
herdr-lab *ARGS:
    ${PYTHON_BIN:-python3} "{{_HERDR_LAB}}" {{ARGS}}
