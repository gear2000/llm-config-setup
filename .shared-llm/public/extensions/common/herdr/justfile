# Herdr runner entry module — justfile-driven bring-up and plan kickoff.
#
# Herdr runs agents NATIVELY in panes (visible TUIs, agent-status tracked in the
# sidebar); nothing here ever runs a harness headless. These recipes are the
# alternative entry point to starting Claude Code / Pi by hand and typing the
# slash command — `just` drives the Herdr socket directly.
#
# This module is PUBLIC (kit-synced) and lands in a destination at
#   .shared-llm/public/extensions/common/herdr/
# To adopt, import it (plus its two sibling engines) from your root justfile:
#   import '.shared-llm/public/extensions/common/upagent/justfile'
#   import '.shared-llm/public/extensions/common/specialist/justfile'
#   import '.shared-llm/public/extensions/common/herdr/justfile'
#
# Requires the `herdr` CLI on PATH with a running Herdr. The engines are driven
# over the Herdr unix socket, so these work from any shell (HERDR_ENV is set
# explicitly where an engine insists on it).
#
# FUTURE: a `herdr-plan-from-issue <github-or-linear-ref>` recipe can fetch the
# plan/details from a GitHub or Linear issue into a run dir (plan.md +
# route.yaml) and then delegate to `herdr-plan` — the kickoff below stays the
# single entry seam, so issue-driven runs are an additive fetcher, not a fork.

_UPAGENT := justfile_directory() + "/.shared-llm/public/extensions/common/upagent/recruiter.py"
_SPECIALIST := justfile_directory() + "/.shared-llm/public/extensions/common/specialist/hub.py"

# Bring up the always-up shared services (UpAgent Recruiter + Specialist Librarian,
# each in its own role-labeled pane in the `shared-services` workspace, registered
# in Herdr's agents sidebar), then print the status table so you can SEE it is up.
herdr-up:
    ${PYTHON_BIN:-python3} {{_UPAGENT}} up
    HERDR_ENV=1 ${PYTHON_BIN:-python3} {{_SPECIALIST}} up
    @{{just_executable()}} --justfile "{{justfile()}}" herdr-status

# Status of the shared services as a table with ✓ up (green) / ✗ down (red).
herdr-status:
    #!/usr/bin/env bash
    set -euo pipefail
    ${PYTHON_BIN:-python3} - <<'PY'
    import json, subprocess, os
    G, R, DIM, RST = "\033[32m", "\033[31m", "\033[2m", "\033[0m"
    def live_panes():
        try:
            out = subprocess.run(["herdr","pane","list"], capture_output=True, text=True)
            return {p["pane_id"] for p in json.loads(out.stdout)["result"]["panes"]}
        except Exception:
            return set()
    panes = live_panes()
    def read(p):
        try: return json.load(open(p))
        except Exception: return None
    rows = []
    # recruiter
    rec = read(os.environ.get("UPAGENT_STATE", "/tmp/.upagent/recruiter.json"))
    if rec and rec.get("recruiter_pane") in panes:
        rows.append(("recruiter", True, f"pane {rec['recruiter_pane']} · roster {os.path.basename(rec.get('roster',''))}"))
    else:
        rows.append(("recruiter", False, "not up — run `just herdr-up`"))
    # librarian
    lib = read(os.environ.get("SPECIALIST_STATE", "/tmp/.herdr-specialist/state.json"))
    idx = read("/tmp/.herdr-specialist/index.json")
    n = len(idx) if isinstance(idx, (dict, list)) else 0
    if lib and lib.get("librarian_pane") in panes:
        detail = f"pane {lib['librarian_pane']}" + (f" · {n} specialists" if n else "")
        rows.append(("librarian", True, detail))
    else:
        rows.append(("librarian", False, "not up — run `just herdr-up`"))
    W = max(len(d) for _,_,d in rows + [("","","Herdr shared services")])
    bar = "─" * (W + 2)
    print(f"┌──────────────┬────────┬{bar}┐")
    print(f"│ hub          │ state  │ {'detail'.ljust(W)} │")
    print(f"├──────────────┼────────┼{bar}┤")
    for name, up, detail in rows:
        mark = f"{G}✓ up  {RST}" if up else f"{R}✗ down{RST}"
        print(f"│ {name.ljust(12)} │ {mark} │ {DIM}{detail.ljust(W)}{RST} │")
    print(f"└──────────────┴────────┴{bar}┘")
    PY

# Tear down the shared services (the Librarian pane via its engine; the
# Recruiter pane via the pane id its state file recorded), then show the table.
herdr-down:
    #!/usr/bin/env bash
    set -euo pipefail
    HERDR_ENV=1 ${PYTHON_BIN:-python3} {{_SPECIALIST}} down || true
    state="${UPAGENT_STATE:-/tmp/.upagent/recruiter.json}"
    if [ -f "$state" ]; then
        pane=$(${PYTHON_BIN:-python3} -c "import json;print(json.load(open('$state'))['recruiter_pane'])")
        herdr pane close "$pane" >/dev/null 2>&1 || true
        rm -f "$state"
        echo "down: closed recruiter pane $pane"
    else
        echo "down: no recruiter state file"
    fi
    {{just_executable()}} --justfile "{{justfile()}}" herdr-status || true

# Kick off a checked plan through the Herdr-native runner with a FRESH TUI agent
# in a fresh `<slug>` cockpit workspace — no manual harness start, no typing the
# slash command. `dir` is the run dir holding plan.md + route.yaml; `slug` names
# the workspace (defaults to the dir basename). The TUI agent (running /herdr-run)
# gates the pair with the meta-plan check, finishes the cockpit layout, and drives
# the phases; workers are hired per stage through the Recruiter, so run
# `just herdr-up` first.
#
# The TUI is launched fully NON-INTERACTIVE (claude --dangerously-skip-permissions
# / pi --approve) — it trusts its cwd and never blocks on a trust/permission dialog
# — and the harness self-registers as a Herdr agent (name `tui-agent`), so it shows
# up in the agents sidebar and in Herdr's remote/phone agent list for you to watch
# and drive on the move.
#
#   just herdr-plan ops/work-log/2026-07-12/my-feature
#   just herdr-plan ops/work-log/2026-07-12/my-feature/plan/v1 my-feature
#   just herdr-plan ops/work-log/2026-07-12/my-feature "" pi
herdr-plan dir slug="" harness="claude":
    #!/usr/bin/env bash
    set -euo pipefail
    dir="$(realpath "{{dir}}")"
    plan="$dir/plan.md"; route="$dir/route.yaml"
    [ -f "$plan" ]  || { echo "error: $plan not found (a run dir needs plan.md + route.yaml)" >&2; exit 1; }
    [ -f "$route" ] || { echo "error: $route not found (a run dir needs plan.md + route.yaml)" >&2; exit 1; }
    slug="{{slug}}"; [ -n "$slug" ] || slug="$(basename "$dir")"
    repo="{{invocation_directory()}}"
    # Non-interactive launch flags per harness — a TUI that blocks on a trust or
    # permission dialog stalls the whole run.
    case "{{harness}}" in
        claude) launch="claude --dangerously-skip-permissions" ;;
        pi)     launch="pi --approve" ;;
        *) echo "error: unknown harness '{{harness}}' (claude|pi)" >&2; exit 1 ;;
    esac
    out=$(herdr workspace create --label "$slug" --no-focus)
    pane=$(echo "$out" | ${PYTHON_BIN:-python3} -c 'import sys,json;print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')
    herdr pane rename "$pane" "tui-agent" >/dev/null 2>&1 || true
    herdr pane run "$pane" "cd '$repo' && $launch '/herdr-run --plan $plan --route $route --slug $slug'"
    echo "kicked off: workspace '$slug' pane $pane — $launch running /herdr-run"
    echo "the TUI self-registers as a Herdr agent (tui-agent) — watch it on desktop or phone"
    echo "run 'just herdr-up' first if the status table shows the shared services down"
