#!/usr/bin/env bash
# llm-compose — thin wrapper around the compose engine.
#
# Runs the compose engine against whatever repo you are in. It carries NO business
# logic: it locates the .shared-llm source root + its co-located engine, then execs
# the engine, passing every argument straight through.
#
# Engine location model (self-contained repos): the engine lives next to the
# .shared-llm dir it serves, at  <parent-of-.shared-llm>/tools/harness.py.
# `task install repo` copies BOTH the .shared-llm tree and tools/harness.py
# into a consumer repo, so that repo can recompose standalone — this wrapper is a
# convenience, never a dependency.
#
# Resolution of the .shared-llm root, in order:
#   1. $SHARED_LLM_DIR — explicit override (must be a dir named .shared-llm).
#   2. walk up from $PWD looking for a .shared-llm/ directory.
# Once found, the engine is <root>/../tools/harness.py (the repo that owns
# the .shared-llm dir). Fails loud if either the root or the engine is missing.
#
# Usage (from inside a repo that has a .shared-llm/ tree):
#   llm-compose                                   # compose all recipes
#   llm-compose .shared-llm/compose/claude-md/root.yaml   # compose one
#   llm-compose --target /some/out                # override output base
# Any argument the engine accepts works — this wrapper does not interpret them.

set -euo pipefail

find_shared_llm() {
  # 1. explicit override
  if [[ -n "${SHARED_LLM_DIR:-}" ]]; then
    if [[ -d "$SHARED_LLM_DIR" ]]; then
      printf '%s\n' "$SHARED_LLM_DIR"
      return 0
    fi
    echo "llm-compose: \$SHARED_LLM_DIR is not a directory: $SHARED_LLM_DIR" >&2
    return 1
  fi
  # 2. walk up from $PWD for a .shared-llm/ dir
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.shared-llm" ]]; then
      printf '%s\n' "$dir/.shared-llm"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  echo "llm-compose: no .shared-llm/ found from $PWD upward, and \$SHARED_LLM_DIR is unset" >&2
  return 1
}

SHARED_ROOT="$(find_shared_llm)"
REPO_ROOT="$(dirname "$SHARED_ROOT")"
ENGINE="$REPO_ROOT/tools/harness.py"

if [[ ! -f "$ENGINE" ]]; then
  echo "llm-compose: engine not found next to $SHARED_ROOT (expected $ENGINE)" >&2
  echo "             a repo set up via 'task install repo' carries its own tools/harness.py" >&2
  exit 1
fi

command -v python3 >/dev/null 2>&1 || { echo "llm-compose: python3 not on PATH" >&2; exit 1; }

# The engine resolves its own --shared-llm; pass ours explicitly so the wrapper's
# walk-up wins regardless of where the engine file physically lives.
exec python3 "$ENGINE" compose --shared-llm "$SHARED_ROOT" "$@"
