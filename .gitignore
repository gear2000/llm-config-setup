# Kit self-compose staging — the kit composes ITSELF into examples/ (a gitignored
# staging dir) via `--target examples` so a self-compose never clobbers the kit's
# own hand-maintained root files (CLAUDE.md, README, etc.). install-local.sh /
# install-global.sh also stage agents + global skills here before copying to $HOME.
/examples/

# DEMO samples — the example-package / example-service recipes are illustrative
# only; composing them writes here, kept out of the kit's real src/ tree. A
# consumer install does NOT compose these into the consumer repo.
/samples/

# memsearch plugin — local per-developer session index/state (PID lock file +
# auto-generated session logs embedding this machine's absolute $HOME paths).
# Never committed.
/.memsearch/

# Lavish review artifacts — locally rendered HTML for a single review session,
# naming this machine and its absolute $HOME paths. Never committed.
/.lavish/

# Local work-log config — machine-specific (dir layout + hostname). The tracked
# template is .shared-llm.yaml.example; the real files never belong in the repo.
/.shared-llm.yaml
/.planish.yaml

# npm — safety net so an accidental install under the repo is never tracked
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.shared-llm/public/llm/pi/common/extensions/meta-orchestrator-hub/hub/hub
.pi-lens
.pi
.shared-llm/this_repo
