# .planish.yaml.example
#
# HOW IT WORKS
# ─────────────
# Pi's /planish command writes two files — plan.md and plan.html — into
# a directory you control. You then open the HTML file in a browser to
# read and annotate it.
#
# Two things must be configured together:
#
#   1. WHERE FILES ARE WRITTEN  →  "dir" in this file
#   2. WHERE YOUR HTTP SERVER SERVES FROM  →  the --directory arg of the server
#
# The "dir" path must be INSIDE the directory your server serves, so the HTML
# file has a URL you can actually open.
#
#
# STEP-BY-STEP SETUP
# ──────────────────
# 1. Pick a docs/plans root on your machine, e.g. ~/my-project/docs
#
# 2. Start a static HTTP server from that root:
#
#      python3 -m http.server 8089 --directory ~/my-project/docs
#
#    (run this in a background terminal or add it to a startup script)
#
# 3. Set "dir" below to a path INSIDE that root:
#
#      dir: /home/<you>/my-project/docs/plans/{date}/{slug}
#
#    planish will write:
#      /home/<you>/my-project/docs/plans/2026-06-29/redesign-auth/plan.md
#      /home/<you>/my-project/docs/plans/2026-06-29/redesign-auth/plan.html
#
# 4. Open the HTML file in your browser at:
#
#      http://localhost:8089/plans/2026-06-29/redesign-auth/plan.html
#
#
# TOKENS
# ──────
#   {date}  →  YYYY-MM-DD  (today)
#   {slug}  →  your /planish topic, lowercased and hyphenated
#   {n}     →  next version integer, auto-incremented by scanning siblings
#
# A relative "dir" path resolves from the directory holding THIS file.
# An absolute path is used as-is.
#
#
# REMOTE SESSIONS (optional "host")
# ─────────────────────────────────
# When you reach this machine by name instead of localhost — Tailscale, LAN,
# SSH from a laptop — set "host" to that machine name. Every URL the planning
# flows hand out (the planish pages on port 4390 AND the static grill/plan
# pages) then uses it instead of localhost, and the planish server binds
# 0.0.0.0 so those remote connections are accepted. Default: localhost.
# $PLANISH_HOST overrides it for a single session.
#
#   host: your-machine-name
#
# "host" works on its own too — a .planish.yaml with only "host" keeps the
# default /tmp/planish/{date}/{slug} plan directory.
#
#
# COPY AND RENAME TO ACTIVATE
# ────────────────────────────
# cp .planish.yaml.example .planish.yaml
# Then edit the "dir" line below to match your setup.

dir: /absolute/path/to/your/docs/plans/{date}/{slug}
# host: your-machine-name

# ── Alternative layouts ────────────────────────────────────────────────────────

# If your server root IS your repo root (e.g. python3 -m http.server 8089):
# dir: plans/{date}/{slug}

# If you use an ops/docs directory structure:
# dir: ops/docs/work-log/{date}/{slug}/plan

# Versioned plans (v1, v2, …) in a named folder:
# dir: plans/{slug}/v{n}
